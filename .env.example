# Nebius AI Studio (LLM evaluation)
NEBIUS_API_KEY=change-me
# NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Hugging Face token with access to the gated pyannote diarization models
HF_TOKEN=change-me

# Object Storage bucket + S3 credentials (used by cli.py)
BUCKET=change-me
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
# S3_ENDPOINT=https://storage.eu-north1.nebius.cloud

# Container image cli.py submits to `nebius ai job create`
JOB_IMAGE=<registry>/feedspeechback-job:dev

# Whisper model size inside the job ("small" for cheap smoke tests)
# WHISPER_MODEL=large-v2
